{
  "name": "@sige/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:seed": "node --import tsx src/seed.ts",
    "test": "vitest run src/tests/unit.test.ts",
    "test:integration": "vitest run src/tests/integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@codegenie/serverless-express": "5.0.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "pdfkit": "0.20.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
