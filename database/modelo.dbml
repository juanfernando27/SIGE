// Modelo completo. El DDL ejecutable es esquema_actual_espanol.sql.

Table roles {
  id int [pk, increment]
  name varchar(40) [not null, unique]
}

Table permisos {
  id int [pk, increment]
  name varchar(80) [not null, unique]
}

Table roles_permisos {
  role_id int [not null]
  permission_id int [not null]

  indexes {
    (role_id,permission_id) [pk]
  }
}

Table usuarios {
  id int [pk, increment]
  name varchar(120) [not null]
  email varchar(190) [not null, unique]
  password_hash varchar(255) [not null]
  role_id int [not null]
  status varchar(16) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table sesiones_autenticacion {
  id char(36) [pk]
  user_id int [not null]
  access_hash char(64) [not null, unique]
  refresh_hash char(64) [not null, unique]
  csrf_hash char(64) [not null]
  access_expires_at datetime [not null]
  expires_at datetime [not null]
  revoked_at datetime
  created_at datetime [not null]

  indexes {
    (user_id,expires_at)
  }
}

Table tokens_renovacion_usados {
  token_hash char(64) [pk]
  session_id char(36) [not null]
  expires_at datetime [not null]
}

Table intentos_inicio_sesion {
  id bigint [pk, increment]
  identity_hash char(64) [not null]
  created_at datetime [not null]

  indexes {
    (identity_hash,created_at)
  }
}

Table categorias {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  description varchar(1000) [not null]
  status varchar(16) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table clientes {
  id int [pk, increment]
  identification varchar(40) [not null, unique]
  name varchar(120) [not null]
  phone varchar(40) [not null]
  email varchar(190) [not null]
  address varchar(300) [not null]
  status varchar(16) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table proveedores {
  id int [pk, increment]
  identification varchar(40) [not null, unique]
  name varchar(120) [not null]
  phone varchar(40) [not null]
  email varchar(190) [not null]
  address varchar(300) [not null]
  status varchar(16) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table productos {
  id int [pk, increment]
  code varchar(40) [not null, unique]
  name varchar(140) [not null]
  description varchar(1000) [not null]
  category_id int [not null]
  supplier_id int
  purchase_price "decimal(18,2)" [not null]
  sale_price "decimal(18,2)" [not null]
  min_stock int [not null]
  status varchar(16) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (category_id,status)
    (name)
  }
}

Table inventarios {
  product_id int [pk]
  stock int [not null]
  updated_at datetime [not null]
}

Table ventas {
  id int [pk, increment]
  customer_id int [not null]
  user_id int [not null]
  status varchar(16) [not null]
  total "decimal(18,2)" [not null]
  request_key char(36) [not null, unique]
  request_hash char(64) [not null]
  cancel_reason varchar(500)
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (status,created_at)
    (customer_id,created_at)
  }
}

Table compras {
  id int [pk, increment]
  supplier_id int [not null]
  user_id int [not null]
  status varchar(16) [not null]
  total "decimal(18,2)" [not null]
  request_key char(36) [not null, unique]
  request_hash char(64) [not null]
  cancel_reason varchar(500)
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (status,created_at)
    (supplier_id,created_at)
  }
}

Table detalles_venta {
  id int [pk, increment]
  sale_id int [not null]
  product_id int [not null]
  product_name varchar(140) [not null]
  quantity int [not null]
  unit_price "decimal(18,2)" [not null]
  subtotal "decimal(18,2)" [not null]

  indexes {
    (sale_id,product_id) [unique]
  }
}

Table detalles_compra {
  id int [pk, increment]
  purchase_id int [not null]
  product_id int [not null]
  product_name varchar(140) [not null]
  quantity int [not null]
  unit_price "decimal(18,2)" [not null]
  subtotal "decimal(18,2)" [not null]

  indexes {
    (purchase_id,product_id) [unique]
  }
}

Table movimientos_inventario {
  id bigint [pk, increment]
  product_id int [not null]
  user_id int [not null]
  kind varchar(30) [not null]
  quantity int [not null]
  balance int [not null]
  source_type varchar(30) [not null]
  source_id int
  reason varchar(500) [not null]
  created_at datetime [not null]

  indexes {
    (product_id,source_type,source_id,kind) [unique]
    (product_id,created_at)
  }
}

Table documentos {
  id int [pk, increment]
  user_id int [not null]
  entity_type varchar(30) [not null]
  entity_id int [not null]
  original_name varchar(200) [not null]
  storage_key varchar(100) [not null, unique]
  mime_type varchar(80) [not null]
  size_bytes int [not null]
  provider varchar(10) [not null]
  created_at datetime [not null]

  indexes {
    (entity_type,entity_id)
  }
}

Table imagenes_producto {
  id int [pk, increment]
  product_id int [not null]
  document_id int [not null, unique]
}

Table notificaciones {
  id bigint [pk, increment]
  title varchar(180) [not null]
  message varchar(500) [not null]
  event_key varchar(120) [not null, unique]
  created_at datetime [not null]
}

Table lecturas_notificaciones {
  notification_id bigint [not null]
  user_id int [not null]
  read_at datetime [not null]

  indexes {
    (notification_id,user_id) [pk]
  }
}

Table registros_auditoria {
  id bigint [pk, increment]
  user_id int
  action varchar(80) [not null]
  entity varchar(40) [not null]
  entity_id varchar(50)
  changes json
  result varchar(16) [not null]
  created_at datetime [not null]

  indexes {
    (entity,entity_id)
    (created_at)
  }
}

Ref: roles_permisos.role_id > roles.id
Ref: roles_permisos.permission_id > permisos.id
Ref: usuarios.role_id > roles.id
Ref: sesiones_autenticacion.user_id > usuarios.id
Ref: tokens_renovacion_usados.session_id > sesiones_autenticacion.id
Ref: productos.category_id > categorias.id
Ref: productos.supplier_id > proveedores.id
Ref: inventarios.product_id > productos.id
Ref: ventas.customer_id > clientes.id
Ref: ventas.user_id > usuarios.id
Ref: compras.supplier_id > proveedores.id
Ref: compras.user_id > usuarios.id
Ref: detalles_venta.sale_id > ventas.id
Ref: detalles_venta.product_id > productos.id
Ref: detalles_compra.purchase_id > compras.id
Ref: detalles_compra.product_id > productos.id
Ref: movimientos_inventario.product_id > productos.id
Ref: movimientos_inventario.user_id > usuarios.id
Ref: documentos.user_id > usuarios.id
Ref: imagenes_producto.product_id > productos.id
Ref: imagenes_producto.document_id > documentos.id
Ref: lecturas_notificaciones.notification_id > notificaciones.id
Ref: lecturas_notificaciones.user_id > usuarios.id
Ref: registros_auditoria.user_id > usuarios.id

Table migraciones_esquema {
  name varchar(190) [pk]
  checksum char(64) [not null]
  applied_at datetime [not null]
}
