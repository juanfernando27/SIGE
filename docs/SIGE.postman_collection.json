          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Iniciar sesión; establece cookies HttpOnly",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const v = pm.response.json(); if (v.data && v.data.csrfToken) pm.collectionVariables.set('csrfToken', v.data.csrfToken); }"
